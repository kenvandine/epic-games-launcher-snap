#!/bin/bash

export XDG_CONFIG_HOME="$SNAP_USER_COMMON/.config"
export XDG_DATA_HOME="$SNAP_USER_COMMON/.local/share"

mkdir -p "$XDG_CONFIG_HOME"
mkdir -p "$XDG_DATA_HOME"

# Symlink an entry from SNAP_USER_DATA into SNAP_USER_COMMON.
function link_into_common() {
  local snap_user_data_path="$1"
  local snap_user_common_path="$2"

  [ -e "$snap_user_data_path" ] || [ -L "$snap_user_data_path" ] || return 0

  mkdir -p "$(dirname "$snap_user_common_path")"
  ln -sfn "$snap_user_data_path" "$snap_user_common_path"
}

# Entries desktop-launch creates under $SNAP_USER_DATA/.config
for d in user-dirs.dirs user-dirs.dirs.md5sum user-dirs.locale user-dirs.locale.md5sum \
         fontconfig dconf gtk-2.0 gtk-3.0 gtk-4.0 ibus; do
  link_into_common "$SNAP_USER_DATA/.config/$d" "$SNAP_USER_COMMON/.config/$d"
done

# Entries desktop-launch creates under $SNAP_USER_DATA/.local/share
for d in themes mime glib-2.0 icons; do
  link_into_common "$SNAP_USER_DATA/.local/share/$d" "$SNAP_USER_COMMON/.local/share/$d"
done

if [ -d "$SNAP_USER_DATA/Games" ]; then
    mv -f "$SNAP_USER_DATA/Games" "$SNAP_USER_COMMON/"
fi

if [ -d "$SNAP_USER_DATA/.local/share/com.epicgames.eglv2" ]; then
    mv -f "$SNAP_USER_DATA/.local/share/com.epicgames.eglv2" "$SNAP_USER_COMMON/.local/share/"
fi

exec "$@"
